PORT=4000
NODE_ENV=development
DB_ENABLED=true
DB_PROVIDER=mongo
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/recipe-box
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=recipebox_session
SESSION_EXPIRES_IN=30d
SESSION_STORE=mongo
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CLIENT_ORIGIN=http://localhost:5173
